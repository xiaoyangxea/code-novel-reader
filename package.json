{
  "name": "code-novel-reader",
  "displayName": "Code Novel Reader - 代码小说阅读器",
  "description": "在 VS Code 原生 TypeScript 编辑器中以代码注释阅读在线或本地小说，支持目录、翻页、进度和老板键。",
  "version": "0.7.1",
  "publisher": "xiaoyangxea",
  "license": "MIT",
  "icon": "media/icon.png",
  "pricing": "Free",
  "repository": {
    "type": "git",
    "url": "https://github.com/xiaoyangxea/code-novel-reader.git"
  },
  "homepage": "https://github.com/xiaoyangxea/code-novel-reader#readme",
  "bugs": {
    "url": "https://github.com/xiaoyangxea/code-novel-reader/issues"
  },
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "novel",
    "reader",
    "vscode",
    "epub",
    "txt",
    "typescript",
    "小说",
    "阅读",
    "摸鱼"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:codeNovel.library"
  ],
  "contributes": {
    "commands": [
      {
        "command": "codeNovel.downloadBook",
        "title": "代码小说: 下载到本地 / 导出 TXT",
        "icon": "$(cloud-download)"
      },
      {
        "command": "codeNovel.configureBoss",
        "title": "代码小说: 设置老板键显示内容"
      },
      {
        "command": "codeNovel.saveBossContent",
        "title": "代码小说: 保存当前编辑器为老板键内容"
      },
      {
        "command": "codeNovel.searchOnline",
        "title": "代码小说: 搜索在线小说",
        "icon": "$(search)"
      },
      {
        "command": "codeNovel.importUrl",
        "title": "代码小说: 导入 URL",
        "icon": "$(link)"
      },
      {
        "command": "codeNovel.openLocal",
        "title": "代码小说: 打开本地 TXT/EPUB",
        "icon": "$(folder-opened)"
      },
      {
        "command": "codeNovel.openBook",
        "title": "代码小说: 打开书籍",
        "icon": "$(book-open)"
      },
      {
        "command": "codeNovel.removeBook",
        "title": "代码小说: 从书架移除",
        "icon": "$(trash)"
      },
      {
        "command": "codeNovel.openCatalog",
        "title": "代码小说: 查看目录",
        "icon": "$(list-tree)"
      },
      {
        "command": "codeNovel.refreshCatalog",
        "title": "代码小说: 更新目录",
        "icon": "$(sync)"
      },
      {
        "command": "codeNovel.manageSources",
        "title": "代码小说: 书源管理",
        "icon": "$(server-environment)"
      },
      {
        "command": "codeNovel.clearBrowserData",
        "title": "代码小说: 清除专用浏览器数据"
      },
      {
        "command": "codeNovel.refreshLibrary",
        "title": "代码小说: 刷新书架",
        "icon": "$(refresh)"
      },
      {
        "command": "codeNovel.nextPage",
        "title": "代码小说: 下一页",
        "icon": "$(arrow-right)"
      },
      {
        "command": "codeNovel.previousPage",
        "title": "代码小说: 上一页",
        "icon": "$(arrow-left)"
      },
      {
        "command": "codeNovel.nextChapter",
        "title": "代码小说: 下一章",
        "icon": "$(arrow-right)"
      },
      {
        "command": "codeNovel.previousChapter",
        "title": "代码小说: 上一章",
        "icon": "$(arrow-left)"
      },
      {
        "command": "codeNovel.chooseChapter",
        "title": "代码小说: 选择章节"
      },
      {
        "command": "codeNovel.toggleBoss",
        "title": "代码小说: 老板键",
        "icon": "$(eye-closed)"
      },
      {
        "command": "codeNovel.reloadChapter",
        "title": "代码小说: 重新抓取当前章节"
      }
    ],
    "keybindings": [
      {
        "command": "codeNovel.nextPage",
        "key": "alt+right",
        "when": "codeNovel.readerActive"
      },
      {
        "command": "codeNovel.previousPage",
        "key": "alt+left",
        "when": "codeNovel.readerActive"
      },
      {
        "command": "codeNovel.nextChapter",
        "key": "alt+shift+right",
        "when": "codeNovel.readerActive"
      },
      {
        "command": "codeNovel.previousChapter",
        "key": "alt+shift+left",
        "when": "codeNovel.readerActive"
      },
      {
        "command": "codeNovel.toggleBoss",
        "key": "ctrl+alt+b"
      },
      {
        "command": "codeNovel.chooseChapter",
        "key": "ctrl+alt+l",
        "when": "codeNovel.readerActive"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codeNovel",
          "title": "代码小说",
          "icon": "media/book.svg"
        }
      ]
    },
    "views": {
      "codeNovel": [
        {
          "id": "codeNovel.library",
          "name": "书架"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "codeNovel.searchOnline",
          "when": "view == codeNovel.library",
          "group": "navigation@1"
        },
        {
          "command": "codeNovel.importUrl",
          "when": "view == codeNovel.library",
          "group": "navigation@2"
        },
        {
          "command": "codeNovel.openLocal",
          "when": "view == codeNovel.library",
          "group": "navigation@3"
        },
        {
          "command": "codeNovel.manageSources",
          "when": "view == codeNovel.library",
          "group": "navigation@4"
        },
        {
          "command": "codeNovel.refreshLibrary",
          "when": "view == codeNovel.library",
          "group": "navigation@5"
        }
      ],
      "view/item/context": [
        {
          "command": "codeNovel.downloadBook",
          "when": "view == codeNovel.library && viewItem == codeNovel.book",
          "group": "navigation@3"
        },
        {
          "command": "codeNovel.openCatalog",
          "when": "view == codeNovel.library && viewItem == codeNovel.book",
          "group": "inline@1"
        },
        {
          "command": "codeNovel.removeBook",
          "when": "view == codeNovel.library && viewItem == codeNovel.book",
          "group": "inline@2"
        },
        {
          "command": "codeNovel.openBook",
          "when": "view == codeNovel.library && viewItem == codeNovel.book",
          "group": "navigation@1"
        },
        {
          "command": "codeNovel.refreshCatalog",
          "when": "view == codeNovel.library && viewItem == codeNovel.book",
          "group": "navigation@2"
        }
      ],
      "editor/title": [
        {
          "command": "codeNovel.previousPage",
          "when": "resourceScheme == code-novel && !codeNovel.bossMode && codeNovel.hasPreviousPage",
          "group": "navigation@1"
        },
        {
          "command": "codeNovel.previousChapter",
          "when": "resourceScheme == code-novel && !codeNovel.bossMode && !codeNovel.hasPreviousPage",
          "group": "navigation@1"
        },
        {
          "command": "codeNovel.nextPage",
          "when": "resourceScheme == code-novel && !codeNovel.bossMode && codeNovel.hasNextPage",
          "group": "navigation@2"
        },
        {
          "command": "codeNovel.nextChapter",
          "when": "resourceScheme == code-novel && !codeNovel.bossMode && !codeNovel.hasNextPage",
          "group": "navigation@2"
        },
        {
          "command": "codeNovel.toggleBoss",
          "when": "resourceScheme == code-novel",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "Code Novel Reader",
      "properties": {
        "codeNovel.pageCharacters": {
          "type": "number",
          "default": 1400,
          "minimum": 200,
          "maximum": 10000,
          "description": "每页大约显示的字符数。"
        },
        "codeNovel.commentWidth": {
          "type": "number",
          "default": 72,
          "minimum": 30,
          "maximum": 160,
          "description": "TypeScript 注释每行的最大字符数。"
        },
        "codeNovel.requestTimeout": {
          "type": "number",
          "default": 15000,
          "minimum": 3000,
          "maximum": 60000,
          "description": "网页请求超时（毫秒）。"
        },
        "codeNovel.userAgent": {
          "type": "string",
          "default": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/131 Safari/537.36",
          "description": "抓取公开网页时使用的 User-Agent。"
        },
        "codeNovel.proxy": {
          "type": "string",
          "default": "",
          "description": "可选 HTTP/HTTPS 代理，例如 http://127.0.0.1:7897。普通请求与隔离浏览器共用；留空时读取 VS Code http.proxy、环境变量，再尝试检测本机 Clash Verge 混合端口。"
        },
        "codeNovel.autoDetectProxy": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "description": "未指定代理时，读取本机 Clash Verge 的混合端口并检测是否监听，使 TUN 环境下普通请求与隔离浏览器使用同一代理。"
        },
        "codeNovel.browserRendering": {
          "type": "boolean",
          "default": true,
          "description": "普通抓取无法识别页面时，使用本机 Chrome/Edge/Chromium/Brave 的隔离配置进行渲染。"
        },
        "codeNovel.browserExecutable": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "可选浏览器可执行文件路径。留空时自动查找；出于安全考虑，仅接受用户全局设置，不读取工作区值。"
        },
        "codeNovel.browserTimeout": {
          "type": "number",
          "default": 25000,
          "minimum": 10000,
          "maximum": 60000,
          "description": "浏览器渲染网页的超时时间（毫秒）。"
        },
        "codeNovel.prefetchNextChapter": {
          "type": "boolean",
          "default": true,
          "description": "阅读在线小说时，在后台预取后续章节以加快连续翻章。"
        },
        "codeNovel.prefetchChapterCount": {
          "type": "number",
          "default": 3,
          "minimum": 0,
          "maximum": 10,
          "description": "在线阅读时始终尝试缓存当前章节之后的章节数；设为 0 可停止预取。"
        },
        "codeNovel.searchProviders": {
          "type": "array",
          "default": [],
          "description": "额外搜索源。URL 中用 {keyword} 表示搜索词；结果使用通用 HTML 识别。",
          "items": {
            "type": "object",
            "required": [
              "name",
              "url"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.mjs",
    "compile:production": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "check": "tsc --noEmit",
    "test": "npm run compile && node --test tests/*.test.mjs",
    "audit:security": "npm audit --audit-level=high && npm audit signatures",
    "package": "npm run check && npm test && npm run compile:production && vsce package --no-dependencies"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "iconv-lite": "^0.6.3",
    "jszip": "^3.10.1",
    "undici": "^6.29.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.2"
  }
}
